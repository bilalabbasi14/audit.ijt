# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Required for database and authentication.
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE SERVICE ROLE: Server-only. Required for admin API routes.
# NEVER expose this in the frontend bundle or commit real values.
# Get from Supabase Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# LOG_LEVEL: Optional. Backend API log verbosity: debug | info | warn | error
# Defaults to debug locally and info in production.
LOG_LEVEL="debug"
